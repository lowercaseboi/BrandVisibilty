# Base path/URL the browser uses for API calls. Default "/api", which the Vite
# dev proxy (and nginx in docker) forwards to the backend with "/api" stripped.
# Set a full URL (e.g. http://localhost:8000) only to bypass the proxy.
VITE_API_BASE=/api

# Where the Vite dev proxy forwards /api/* (read by vite.config.ts at startup,
# e.g. `API_PROXY_TARGET=http://backend:8000 npm run dev`).
API_PROXY_TARGET=http://localhost:8000
