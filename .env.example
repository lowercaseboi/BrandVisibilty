# AI Visibility Platform — environment configuration
#
# Copy to `.env.local` (git-ignored) in the repo root:   cp .env.example .env.local
#
# Fill in ANY ONE key below and run — the pipeline (providers="auto") uses every provider
# that has a key. Leave ALL of them empty to run the fully offline synthetic demo
# (clearly labelled "synthetic" in the dashboard; no network calls).
#
# Real environment variables (shell exports, Docker `environment:`) override this file.
# Keys are never logged or returned by the API. Blank values mean "not configured";
# blank *_MODEL values fall back to the defaults shown.

# --- Google Gemini --------------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# --- OpenAI (or any proxy that speaks OpenAI's API, via OPENAI_BASE_URL) --------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Groq (free tier available: https://console.groq.com/keys) ------------------------
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- OpenRouter (many models, some free: https://openrouter.ai/keys) ------------------
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Anthropic Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Ollama (local models, no key). Setting OLLAMA_BASE_URL enables it for "auto". ----
# From Docker, use http://host.docker.internal:11434
OLLAMA_BASE_URL=
# OLLAMA_MODEL=llama3.2

# --- Any other OpenAI-compatible endpoint (LM Studio, vLLM, Together, ...) ------------
# Needs both a base URL (ending in /v1 for most servers) and a model; key is optional.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# --- Storage --------------------------------------------------------------------------
# Where snapshots / brands / replay cache are written (default: backend/data).
# DATA_DIR=
